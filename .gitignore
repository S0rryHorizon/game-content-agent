.venv/

.env
.env.*
!.env.example

__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.pyright/

.coverage
coverage.xml
htmlcov/

.DS_Store

data/runtime/*
!data/runtime/.gitkeep

# Private state and credentials are never part of a public snapshot.
*.sqlite
*.sqlite3
*.db
*.sqlite-wal
*.sqlite-shm
*.sqlite3-wal
*.sqlite3-shm
*.pem
*.key

# Local-only workspace: internal notes, plans, migration records and Git backups.
# These files stay on this computer and must never be force-added or pushed.
/private/
*.bundle

# Defensive exclusions if internal documents are copied back to the root.
/CONTEXT.md
/docs/
/主项目导师式执行手册.md
/主项目导师式执行计划.xlsx
